// ══════════════════════════════════════════════════════════════════
//  ШАБЛОН УСТРОЙСТВА · EAZYTECH
//
//  Как добавить новое устройство:
//  1. Скопируй этот файл и переименуй как угодно (латиницей, .json).
//  2. Заполни поля своими данными — комментарии можно оставлять,
//     загрузчик вырезает их перед парсингом.
//  3. Впиши имя файла в data/devices/index.json.
//  4. Обнови страницу — устройство в каталоге.
//
//  Обязательные поля: id, name, brand, category, short, price,
//  fairPrice, scores. Остальное опционально — если поля нет,
//  соответствующая секция на сайте просто скрывается.
// ══════════════════════════════════════════════════════════════════
{
  // id — латиницей, без пробелов. По нему строятся ссылки на страницу.
  "id": "test-device",

  // Название — как показывается на карточке и в заголовке страницы.
  "name": "Тестовая мышь — образец",

  // Бренд — по нему собирается фильтр «Бренд».
  "brand": "Example",

  // Категория. Доступные: "mice" | "keyboards" | "headphones".
  "category": "mice",

  // Картинки — массив ссылок (https://...). Первая идёт на карточку
  // и в hero, остальные — в галерею. Пустой массив или нет поля —
  // отрисуется заглушка из первых букв названия.
  "images": [],

  // Короткая подпись на карточке — одна-две строки.
  "short": "Это файл-образец. Скопируй его, заполни своими данными — и устройство появится в каталоге.",

  // Полное описание. Абзацы разделяются пустой строкой (\n\n) —
  // на странице они станут секцией «Разбор».
  "description": "Первый абзац описания. Расскажи, что это за устройство и чем цепляет.\n\nВторой абзац. Разбивай текст через пустую строку — каждый кусок превратится в отдельный параграф.",

  // Цена в гривнах — базовая валюта базы. На сайте пересчитывается
  // в доллары / евро / рубли, если пользователь сменил валюту в настройках.
  "price": 2990,

  // Честная цена (fair). На бар-чарте всё, что дороже, — красное
  // и трясётся, дешевле — бирюзовое. Если price <= fairPrice,
  // автоматически вешается тег «Fair deal».
  "fairPrice": 2800,

  // Оценки в формате бенчмарков: от 0 до 10 000 000. Ключей может
  // быть сколько угодно:
  //   community — оценка общества
  //   personal  — личная оценка
  //   ai        — оценка ИИ
  // Средний балл и места в топах (ТОП 1, ТОП 2...) считаются
  // автоматически по всем ключам.
  "scores": { "community": 7000000, "personal": 6500000, "ai": 6100000 },

  // Класс для фильтра «Класс»:
  //   budget   — Дешевка
  //   value    — Топ за свои деньги
  //   balanced — Цена = качество
  "class": "value",

  // Подключение:
  //   wired    — Проводная
  //   wireless — Беспроводная
  //   hybrid   — Комбинированная
  "connection": "wireless",

  // Переключатели (для клавиатур):
  //   mechanical — Механика
  //   magnetic   — Магнитка
  //   optical    — Оптическая
  //   membrane   — Мембрана
  // Для мышей и наушников можно не указывать вовсе.
  "mechanism": null,

  // true — повесить красный пульсирующий тег «Колхоз».
  "kolhoz": false,

  // Обзоры. Счётчик на карточке, список — на странице устройства.
  "reviews": [
    { "author": "Имя", "score": 8, "date": "2026-01-01", "text": "Текст обзора." }
  ],

  // Характеристики — любые пары «название: значение», рендерятся сеткой.
  "specs": { "Вес": "80 г", "Сенсор": "Пример" },

  // Цены по магазинам для бар-чарта.
  "shops": [
    { "name": "DNS", "price": 2990 },
    { "name": "OZON", "price": 2790 }
  ],

  // Плюсы и минусы.
  "pros": ["Плюс раз", "Плюс два"],
  "cons": ["Минус раз"],

  // Долговечность (таймлайн «Когда песочить»):
  //   months — ожидаемый срок службы, месяцев
  //   risk   — месяц первых звоночков (точка риска)
  //   fail   — месяц, когда дешевле выкинуть, чем чинить
  // Нет поля — секция скрывается.
  "life": { "months": 24, "risk": 12, "riskLabel": "Что ломается первым.", "fail": 36, "failLabel": "Что умирает потом." },

  // 10 осей для радара, шкала 0–10. Нет поля — секция скрывается.
  "bench": {
    "input": 7.0, "ergo": 7.5, "materials": 6.5, "features": 6.0, "reliability": 7.0,
    "support": 5.0, "build": 7.0, "software": 5.5, "value": 8.0, "feel": 6.5
  }
}
